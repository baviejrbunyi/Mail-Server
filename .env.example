# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Upstash QStash Configuration
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# Note: SMTP is 100% Bring-Your-Own-SMTP (BYOS). No server-side SMTP credentials are used.
# Callers provide their own SMTP credentials (e.g. Gmail App Password, Amazon SES, Resend)
# in the request payload via the required 'smtp' object.

# App URL
NEXT_PUBLIC_APP_URL="https://your-vercel-app.vercel.app"
